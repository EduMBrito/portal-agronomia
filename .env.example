# Modelo. Copiar para .env no servidor, preencher e dar chmod 600.
# O que cada variável faz está em docs/INFRAESTRUTURA.md, seção 8.

SECRET_KEY=gere-com-python-secrets-token-hex-50
DEBUG=True

# Em produção: o subdomínio do portal, mais `localhost`. O `localhost` não é
# opcional — é o Host que o healthcheck do container usa, e sem ele o Django
# devolve 400 e o serviço nunca fica saudável.
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção o banco é o PostgreSQL compartilhado em pve-db, não um container
# deste stack: DB_HOST=172.16.172.12, com database e usuário dedicados.
DB_NAME=portal_agronomia
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

WAGTAIL_SITE_NAME=Portal Agronomia IFSertãoPE
WAGTAILADMIN_BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Só durante a validação interna, antes de o certificado existir ---
#
# Os três têm default True e é assim que devem ficar assim que houver TLS.
# Enquanto o Caddy encaminha em HTTP puro, os três em False deixam validar o
# portal inteiro, inclusive o login do painel: com os cookies marcados Secure,
# o de CSRF não é setado em HTTP e o login falha com "CSRF verification failed".
#
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# Versão das imagens a rodar, do GHCR. Default `latest`, que é a última tag
# `vX.Y.Z` publicada. Para fixar ou voltar atrás, use o sha curto que a CI
# publica — esse nunca é reescrito:
#
#     PORTAL_TAG=v0.5.0
#     PORTAL_TAG=235fb52abc12
#
PORTAL_TAG=latest

# Opcionais, com default: GUNICORN_WORKERS=3, DJANGO_LOG_LEVEL=ERROR
