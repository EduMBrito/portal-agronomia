# Modelo. Copiar para .env no servidor, preencher e dar chmod 600.
# O que cada variável faz está em docs/INFRAESTRUTURA.md, seção 8.

SECRET_KEY=gere-com-python-secrets-token-hex-50
DEBUG=True

# Em produção: o subdomínio do portal, mais `localhost`. O `localhost` não é
# opcional — é o Host que o healthcheck do container usa, e sem ele o Django
# devolve 400 e o serviço nunca fica saudável.
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção o banco é o PostgreSQL compartilhado em pve-db, não um container
# deste stack: DB_HOST=172.16.172.12, com database e usuário dedicados.
DB_NAME=portal_agronomia
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

WAGTAIL_SITE_NAME=Portal Agronomia IFSertãoPE
WAGTAILADMIN_BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# HTTPS. Os três têm default True e é assim que ficam em produção: o TLS é
# terminado pelo Caddy do pve-proxy e o Django recebe X-Forwarded-Proto: https.
# Só pôr False para depurar sem TLS — em HTTP puro, com os cookies Secure, o de
# CSRF não é setado e o login do painel falha com "CSRF verification failed".
#
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Versão das imagens a rodar, do GHCR. OBRIGATÓRIA — o Compose recusa subir sem
# ela. Use uma tag vX.Y.Z ou o sha curto (12 caracteres) que a CI publica a cada
# push na main; o sha nunca é reescrito. Não use `latest` nem `main`: mudam de
# conteúdo sem aviso e impedem saber o que está rodando.
#
#     PORTAL_TAG=v0.5.0
#     PORTAL_TAG=90b717d7a30a
#
PORTAL_TAG=

# Opcionais, com default: GUNICORN_WORKERS=3, DJANGO_LOG_LEVEL=ERROR
