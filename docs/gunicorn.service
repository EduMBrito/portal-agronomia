[Unit]
Description=Portal Agronomia IFSertãoPE — Gunicorn
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/portal-agronomia
EnvironmentFile=/var/www/portal-agronomia/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
ExecStart=/var/www/portal-agronomia/.venv/bin/gunicorn \
          config.wsgi:application \
          --workers 3 \
          --bind 127.0.0.1:8000
Restart=always

[Install]
WantedBy=multi-user.target
